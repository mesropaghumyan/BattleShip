@page "/"
@inject GameHttpClient GameClient
@inject NavigationManager Navigation

<PageTitle>Bataille navale</PageTitle>

<h1>Bataille navale</h1>

<label for="difficulty">Difficulté</label>
<select id="difficulty" class="form-select mb-3" @bind="selectedDifficulty">
    <option value="@Difficulty.Easy">Facile</option>
    <option value="@Difficulty.Hard">Difficile</option>
</select>

<button class="btn btn-primary" disabled="@isCreating" @onclick="StartGameAsync">
    @(isCreating ? "Création..." : "Nouvelle partie")
</button>

@if (errorMessage is not null)
{
    <div class="alert alert-danger mt-3" role="alert">
        @errorMessage
    </div>
}

@code {
    private bool isCreating;
    private string? errorMessage;
    private Difficulty selectedDifficulty = Difficulty.Easy;

    private async Task StartGameAsync()
    {
        if (isCreating)
            return;

        errorMessage = null;
        isCreating = true;

        try
        {
            var gameId = await GameClient.CreateGameAsync(selectedDifficulty);
            Navigation.NavigateTo($"/play/{gameId}");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"CreateGameAsync failed: {ex}");
            errorMessage = "Impossible de créer la partie. Vérifiez que l'API est démarrée puis réessayez.";
            isCreating = false;
        }
    }
}
